modules = ["nodejs-24", "python-base-3.13"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 21283
externalPort = 3000

[deployment]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Fetta Preview"

[[workflows.workflow]]
name = "Fetta Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Fetta-Engineering-Organization/Fetta-Engineering-Organization/artifacts/fetta && PORT=5000 pnpm run dev -- --host 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
